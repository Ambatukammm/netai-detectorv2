# Everything here is optional; defaults work. Copy this file to .env (read automatically).
# NETAI_MODE=auto            # auto | live | demo | off
# NETAI_INTERFACE=           # leave empty for the system default
# NETAI_LEARN_WINDOWS=60
# NETAI_OPEN_BROWSER=1
# NETAI_NO_ELEVATE=0         # 1 = never ask for admin/sudo
NETAI_HOST=127.0.0.1
NETAI_PORT=8000
NETAI_API_KEY=

# --- Investigation (all optional) ---
# NETAI_EVIDENCE=high        # off | high | medium | all  (headers-only .pcap files for incidents)
# NETAI_EVIDENCE_MAX_MB=200
# NETAI_TRUSTED_HOSTS=       # e.g. 192.168.1.50,192.168.1.60 (your scanner, backup server)

# --- Alerts (desktop is on by default) ---
# NETAI_ALERT_MIN_SEVERITY=high
# NETAI_ALERT_DESKTOP=1
# NETAI_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# NETAI_SMTP_HOST=smtp.gmail.com
# NETAI_SMTP_PORT=587
# NETAI_SMTP_USER=you@example.com
# NETAI_SMTP_PASSWORD=       # for Gmail use an app password
# NETAI_ALERT_EMAIL_TO=you@example.com
# NETAI_ALERT_INCLUDE_HOSTS=1   # 0 = hide IP addresses in email/Slack

# --- Devices, scanning, SPAN ---
# NETAI_RESOLVE_NAMES=1
# NETAI_NMAP=                # path to nmap if not found automatically
# NETAI_SCAN_MAX_MINUTES=60
# NETAI_PASSIVE_DISCOVERY=1
# NETAI_PROMISCUOUS=1        # needed to see SPAN/mirror traffic

# --- Aya, the local AI analyst (or set her up on the Settings page) ---
# NETAI_AYA_ENGINE=builtin   # builtin | ollama | openai (LM Studio, llama.cpp, LocalAI)
# NETAI_AYA_URL=http://127.0.0.1:11434
# NETAI_AYA_MODEL=llama3.1:8b
# NETAI_AYA_TIMEOUT=300
